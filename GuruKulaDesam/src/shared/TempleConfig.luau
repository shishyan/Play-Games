-- ============================================================================
-- 2. FOLDED-DISTANCE MAP OF INDIA COORDINATE PROJECTION
-- Maps real Indian Latitude (6.0°N .. 34.5°N) & Longitude (68.5°E .. 92.5°E)
-- onto our 3D Satellite Continent Canvas (X: -320..320, Z: -480..480)
-- ============================================================================
TempleConfig.MapBounds = {
	MinLat = 6.0,
	MaxLat = 34.5,
	MinLon = 68.5,
	MaxLon = 92.5,
	WorldWidth = 640,  -- X span (-320 to +320)
	WorldLength = 960, -- Z span (-480 North Himalayas to +480 South Ocean/Sri Lanka)
}

function TempleConfig.latLonToWorld(lat: number, lon: number, altitude: number?): Vector3
	local b = TempleConfig.MapBounds
	local nx = (lon - b.MinLon) / (b.MaxLon - b.MinLon)
	local nz = 1.0 - ((lat - b.MinLat) / (b.MaxLat - b.MinLat)) -- North is -Z, South is +Z
	local worldX = (nx - 0.5) * b.WorldWidth
	local worldZ = (nz - 0.5) * b.WorldLength
	return Vector3.new(worldX, altitude or 2, worldZ)
end

