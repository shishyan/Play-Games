-- 2. TRUE SUBCONTINENT WORLD SCALE + TOWN STREET-LEVEL DIMENSIONS
-- India spans 16,000 x 24,000 studs so walking between states takes hours
-- (requiring Train, Flight, or Highway Car), while each Temple Town is a rich
-- 720 x 720 stud street-level zone with 4 Mada Veedhi streets & winding hill steps!
-- ============================================================================
TempleConfig.MapBounds = {
	MinLat = 6.0,
	MaxLat = 34.5,
	MinLon = 68.5,
	MaxLon = 92.5,
	WorldWidth = 16000,  -- X span (-8,000 to +8,000 studs)
	WorldLength = 24000, -- Z span (-12,000 North Himalayas to +12,000 South Ocean)
	TownSize = 680,      -- Each Temple Town is a 680x680 stud street-level municipality!
}

function TempleConfig.latLonToWorld(lat: number, lon: number, altitude: number?): Vector3
	local b = TempleConfig.MapBounds
	local nx = (lon - b.MinLon) / (b.MaxLon - b.MinLon)
	local nz = 1.0 - ((lat - b.MinLat) / (b.MaxLat - b.MinLat))
	local worldX = (nx - 0.5) * b.WorldWidth
	local worldZ = (nz - 0.5) * b.WorldLength
	return Vector3.new(worldX, altitude or 2, worldZ)
end

