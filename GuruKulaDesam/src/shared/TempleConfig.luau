function TempleConfig.getIncarnationForKarma(karma: number): IncarnationTier
	local chosen = TempleConfig.SamsaraIncarnations[1]
	for _, tier in ipairs(TempleConfig.SamsaraIncarnations) do
		if karma >= tier.MinKarma then
			chosen = tier
		end
	end
	return chosen
end

