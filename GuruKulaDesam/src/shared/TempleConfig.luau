function TempleConfig.getTempleById(id: string): TempleEntry?
	for _, t in ipairs(TempleConfig.Temples) do
		if t.Id == id then
			return t
		end
	end
	return nil
end

function TempleConfig.getGradeByNumber(gradeNum: number): GurukulaGradeRegion?
	for _, g in ipairs(TempleConfig.GurukulaGrades) do
		if g.Grade == gradeNum then
			return g
		end
	end
	return nil
end

return TempleConfig
